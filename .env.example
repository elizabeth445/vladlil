# No configuration or external services are required for local use.
# Optional: override the exact origin if using another local hostname/port.
# APP_ORIGIN=http://127.0.0.1:3000
# Optional server-only overrides. Local secure defaults are generated in .data/.
# ADMIN_PASSWORD_HASH=scrypt:...
# ADMIN_SESSION_SECRET=at-least-32-random-characters

# On Vercel, submissions and organizer routes are disabled by default.
# Forms keep browser drafts. Do not enable cloud submissions without persistent storage.
# NEXT_PUBLIC_SUBMISSIONS_ENABLED=false
